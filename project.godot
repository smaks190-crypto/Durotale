config_version=5

[application]
config/name="Дурка — Сквозняк"
run/main_scene="res://Episode.tscn"
config/features=PackedStringArray("4.6", "C#", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.025,0.027,0.025,1)

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="Durotale"

[input]
use={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.065,0.065,0.06,1)
