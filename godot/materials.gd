extends RefCounted

# Small scanned surfaces sampled from the supplied concept dossier.
static var cache := {}
static func get_map(id:String)->ImageTexture:
    if cache.has(id):return cache[id]
    var data := ""
    match id:
        "wall":data=""
        "glass":data=""
        "iron":data=""
        "fabric":data=""
        "tile":data=""
    var image:=Image.new()
    image.load_jpg_from_buffer(Marshalls.base64_to_raw(data))
    image.generate_mipmaps()
    var texture:=ImageTexture.create_from_image(image)
    cache[id]=texture
    return texture
